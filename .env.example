# ShieldX Environment Configuration

# Application
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated list of allowed origins, e.g. http://localhost:5173,https://shieldx.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (defaults to SQLite for local development, or PostgreSQL URL for production)
DATABASE_URL=sqlite:///./shieldx.db
# DATABASE_URL=postgresql://user:password@hostname:5432/shieldx

# Security & Encryption
# 32-byte urlsafe base64-encoded AES-256 Fernet key for field-level encryption
ENCRYPTION_KEY=P5TxtlH997K9RpA7qt6YxRQr-WrzZCnjCZ0-Bzga43o=
JWT_SECRET=1136873194ef26e8e9ddea2feeba33d93747b392c2a656b9de906b5f59b3bd31
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Engine (Google Gemini API)
# If left empty, ShieldX automatically uses the built-in offline threat reasoning engine
GEMINI_API_KEY=

# Google OAuth2 Credentials ("Sign in with Google")
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Apple OAuth2 Credentials ("Sign in with Apple")
APPLE_OAUTH_CLIENT_ID=com.shieldx.web.service
APPLE_OAUTH_CLIENT_SECRET=your-apple-client-secret
